#define all(x) (x).begin(),(x).end()

template<typename T>
struct kuhn_munkres{

    static constexpr T INF=numeric_limits<T>::max()>>1;

    int n,m;
    vector<vector<int>> adj;
    vector<int> match;
    vector<T> lx,ly,slack;
    vector<bool> visx,visy;

    kuhn_munkres(int _,int __):n(_),m(__),adj(_,vector<int>(__,0)),match(__),lx(_),ly(__),slack(__),visx(_),visy(__){}

    inline void addedge(int a,int b,T c){
        adj[a][b]=c;
    }

    bool dfs(int now,bool aug){
        if(visx[now])return 0;
        visx[now]=1;
        for(int i = 0;i<m;i++){
            if(visy[i])continue;
            if(lx[now]+ly[i]==adj[now][i]){
                visy[i]=1;
                if(match[i]==-1||dfs(match[i],aug)){
                    if(aug)match[i]=now;
                    return 1;
                }
            }
            else slack[i]=min(slack[i],lx[now]+ly[i]-adj[now][i]);
        }
        return 0;
    }

    inline bool augment(){
        for(int i = 0;i<m;i++)if(!visy[i]&&!slack[i]){
            visy[i]=1;
            if(match[i]==-1||dfs(match[i],0))return 1;
        }
        return 0;
    }

    inline void relabel(){
        T delta=INF;
        for(int i = 0;i<m;i++)if(!visy[i])delta=min(delta,slack[i]);
        for(int i = 0;i<n;i++)if(visx[i])lx[i]-=delta;
        for(int i = 0;i<m;i++){
            if(visy[i])ly[i]+=delta;
            else slack[i]-=delta;
        }
    }

    inline bool tight(int x){
        fill(all(visx),0),fill(all(visy),0);
        return dfs(x,1);
    }

    inline T operator()(){
        fill(all(lx),0),fill(all(ly),0),fill(all(match),-1);
        for(int i = 0;i<n;i++)for(int j = 0;j<m;j++)lx[i]=max(lx[i],adj[i][j]);
        for(int i = 0;i<n;i++){
            fill(all(slack),INF);
            if(tight(i))continue;
            while(!augment())relabel();
            tight(i);
        }
        T ans=0;
        for(int i = 0;i<m;i++)if(match[i]!=-1)ans+=adj[match[i]][i];
        return ans;
    }

};
