const int LOG_A = 30;
int basis[LOG_A];

void add(int x) {
    for (int i = LOG_A - 1; i >= 0; i--){
        if (x & (1 << i)) {
            if (!basis[i]) {
                basis[i] = x;
                return;
            }
            x ^= basis[i];
        }
    }
}

bool check(int x){
    for (int i = LOG_A - 1; i >= 0; i--){
        if(x & (1<<i)){
            if(!basis[i]) 
                return 0;
            x ^= basis[i];
        }
    }
    return 1;
}

int get_max(){
    int ans = 0;
    for (int i = LOG_A - 1; i >= 0; i--){
        ans = max(ans, ans ^ basis[i]);
    }
    return ans;
}
